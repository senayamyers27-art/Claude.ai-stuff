{
  "ci": {
    "collect": {
      "url": [
        "https://11elevendallas.com/",
        "https://11elevendallas.com/support.html",
        "https://11elevendallas.com/privacy.html",
        "https://11elevendallas.com/terms.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*support\\.html).*$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.5 }]
          }
        },
        {
          "matchingUrlPattern": ".*support\\.html$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.5 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-results"
    }
  }
}
